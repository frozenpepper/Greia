#!/bin/sh
set -eu

PREREQ=""
prereqs() {
  echo "$PREREQ"
}

case "${1:-}" in
  prereqs)
    prereqs
    exit 0
    ;;
esac

# The overlay is present before apt configures the kernel. During those early
# package postinst runs Python and the canonical Plymouth theme may not yet be
# ready, so deliberately no-op. The image builders run update-initramfs again
# after package installation and after copying the Greia theme into /usr/share.
[ -x /usr/bin/python3 ] || exit 0
[ -d /usr/share/plymouth/themes/greia ] || exit 0
[ -r /usr/lib/greia-os/boot-animation/generate.py ] || exit 0
[ -d /usr/lib/greia-os/boot-animation/data ] || exit 0

/usr/bin/python3 /usr/lib/greia-os/boot-animation/generate.py \
  --data-dir /usr/lib/greia-os/boot-animation/data \
  --output-dir /usr/share/plymouth/themes/greia/frames

# Include the exact generated frames directly. This does not depend on the
# distro Plymouth hook's ordering or asset-discovery implementation.
if [ -n "${DESTDIR:-}" ]; then
  install -d -m 0755 "$DESTDIR/usr/share/plymouth/themes/greia/frames"
  cp -a /usr/share/plymouth/themes/greia/frames/. \
    "$DESTDIR/usr/share/plymouth/themes/greia/frames/"
fi
