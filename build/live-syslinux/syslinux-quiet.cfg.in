# Greia live installer - QUIET syslinux configuration (BIOS legacy USB).
#
# Selected by tools/build-live-usb.sh when the installer image declares
# boot.console_policy = "quiet" (the developer release-candidate profile).
# Developer images with the diagnostic policy keep syslinux.cfg.in unchanged.
#
# The default entry boots silently: no kernel/systemd text, no cursor.
# panic=0 still holds: a fatal kernel/initramfs error is never turned into a
# timed reboot loop.
#
# The console stays tty1, never the null console. Silence comes from
# quiet/loglevel=0/show_status=false/cursor off, not from removing the console:
# the Debian 686 kernel has no ttynull driver (CONFIG_NULL_TTY unset), so a
# null console leaves the system with no console at all, PID 1 starts without
# stdin/stdout/stderr, live-boot's Live() dies on its first `exec 6>&1`
# ("Bad file descriptor") and the kernel panics before any pixel is drawn.
# That froze the 2026-10-17 RC stick on the Syslinux banner (QEMU-reproduced).
#
# nonetworking: the live root uses systemd-networkd and has no /etc/network;
# without it live-boot's Netbase() prints "/init: line 29: can't create
# /root/etc/network/interfaces" on screen (and runs a useless udev settle).
#
# Verbose recovery path (owner only, no menu is ever shown to a child): hold
# Shift or Alt (or switch Caps Lock / Scroll Lock on) while the stick boots.
# Syslinux then shows its "boot:" prompt; type   verbose   and press Enter.
# That entry carries exactly the diagnostic arguments of syslinux.cfg.in
# (console=tty1, status output, visible cursor).
#
# Not hidden by this file: the two short Syslinux lines (version banner and
# "Loading ...") printed before the kernel starts. Hiding them needs the
# clear-screen display-file trick that the 2026-08-20 regression review banned; it
# requires an explicit owner decision and a physical Acer test first.
DEFAULT live
PROMPT 0
TIMEOUT 0

LABEL live
    LINUX /vmlinuz
    INITRD /initrd.img
    APPEND boot=live components live-media-path=/ live-media-timeout=30 nopersistence noeject nonetworking overlay-size=128M greia.live_media_id=LIVE_MEDIA_ID silent quiet splash loglevel=0 console=tty1 panic=0 systemd.show_status=false rd.systemd.show_status=false systemd.crash_shell=no systemd.crash_chvt=0 udev.log_priority=3 vt.global_cursor_default=0 consoleblank=0

LABEL verbose
    LINUX /vmlinuz
    INITRD /initrd.img
    APPEND boot=live components live-media-path=/ live-media-timeout=30 nopersistence noeject nonetworking overlay-size=128M greia.live_media_id=LIVE_MEDIA_ID console=tty1 panic=0 loglevel=4 systemd.show_status=true rd.systemd.show_status=true systemd.crash_shell=no udev.log_priority=4 vt.global_cursor_default=1 consoleblank=0
