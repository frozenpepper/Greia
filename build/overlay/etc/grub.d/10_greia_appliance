#!/bin/sh
set -eu
uuid_file=/etc/greia-os/root-filesystem-uuid
[ -s "$uuid_file" ] || { echo "Missing Pip root filesystem UUID" >&2; exit 1; }
root_uuid="$(cat "$uuid_file")"
case "$root_uuid" in
  *[!0-9A-Fa-f-]*|'') echo "Invalid Pip root filesystem UUID" >&2; exit 1 ;;
esac
# Developer/test builds keep the boot observable so a kernel panic prints to
# tty1 and waits 30 s instead of silently rebooting with console=null panic=5.
# Normal/release builds stay fully consoleless (see
# docs/INSTALLED_OS_BOOT_POSTMORTEM.md §16).
console_arg="console=null"
panic_arg="panic=5"
if [ -f /etc/greia-os/developer-remote ]; then
  console_arg="console=tty1"
  panic_arg="panic=30"
fi
theme="/boot/grub/greia-theme.txt"
cat <<EOF
if loadfont unicode ; then
  set gfxmode=auto
  insmod all_video
  insmod gfxterm
  terminal_output gfxterm
fi
if [ -f $theme ]; then
  insmod png
  set theme=$theme
  export theme
fi
set timeout=0
set timeout_style=hidden
menuentry 'Greia OS' --unrestricted --id greia-os {
  search --no-floppy --fs-uuid --set=root $root_uuid
  linux /vmlinuz root=UUID=$root_uuid ro quiet splash loglevel=0 $console_arg $panic_arg systemd.show_status=false rd.systemd.show_status=false systemd.crash_shell=no systemd.crash_chvt=0 udev.log_priority=3 vt.global_cursor_default=0 consoleblank=0
  initrd /initrd.img
}
EOF
