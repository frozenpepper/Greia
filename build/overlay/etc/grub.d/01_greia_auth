#!/bin/sh
set -eu
hash_file=/etc/greia-os/grub-recovery.pbkdf2
[ -s "$hash_file" ] || { echo "Missing Pip GRUB recovery hash" >&2; exit 1; }
hash="$(cat "$hash_file")"
case "$hash" in
  grub.pbkdf2.*) ;;
  *) echo "Invalid Pip GRUB recovery hash" >&2; exit 1 ;;
esac
cat <<EOF
set superusers="pip-recovery"
export superusers
password_pbkdf2 pip-recovery $hash
EOF
