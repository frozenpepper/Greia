# Wi-Fi association/authentication is owned by iwd; IP configuration is owned by systemd-networkd.
#
# Greia ships iwd (and no wpa_supplicant), so iwd is the WPA2 station/authentication
# authority and consumes the .psk/.open profile persisted by the installer.
# That does NOT make iwd the L3/DHCP authority: iwd's built-in network
# configuration is disabled by default unless EnableNetworkConfiguration=true is
# explicitly configured. Greia does not enable it. systemd-networkd therefore
# remains responsible for DHCP after iwd establishes carrier.
#
# Keep this split explicit. Removing DHCP or marking this link Unmanaged leaves a
# successfully associated station without an IPv4 lease on the shipped system.
[Match]
Name=wl* wlan* wlp* wlx*

[Network]
DHCP=yes
