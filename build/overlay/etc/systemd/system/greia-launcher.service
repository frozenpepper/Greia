[Unit]
Description=Greia OS child launcher
After=local-fs.target systemd-tmpfiles-setup.service systemd-logind.service greia-first-boot.service greia-boot-health-credential.service greia-software-update-recover.service
Requires=greia-first-boot.service greia-software-update-recover.service
Wants=greia-parent.service greia-boot-health-credential.service
Conflicts=getty@tty1.service
# Fail-closed existence gate for the volatile runtime roots (D2/P1): PID 1
# evaluates these natively without a fork. Assert (not Condition) so a missing
# root fails the job behind the branded cover instead of silently skipping
# into an X launch. systemd-tmpfiles owns creation every boot.
AssertPathIsDirectory=/run/greia-os
AssertPathIsDirectory=/run/greia-hardware
StartLimitIntervalSec=30
StartLimitBurst=8

[Service]
# Readiness is deliberately NOT a systemd notification, and the reason is a real
# conflict on this platform rather than a missing feature.
#
# The unprivileged X server needs a logind session for seat and device access.
# Measured on the reference Acer: with the session, Xorg starts and finds its
# screen; without it, Xorg aborts with "no screens found" and
# "xf86EnableIO: failed to enable I/O ports 0000-03ff".
#
# But a logind session moves this service's processes into
# /user.slice/user-<uid>.slice/session-N.scope. systemd attributes a READY=1
# datagram to a unit by the sender's cgroup, and it loses the process out of the
# unit's cgroup entirely (Tasks: 0). So Type=notify can never be satisfied here:
# the start job waits out TimeoutStartSec, systemd kills a perfectly working
# Shell, Restart=always restores the splash, and the parent sees a soft reboot
# every ~90 seconds on the login screen and inside the Parent panel alike.
# Type=exec does not help either, because systemd still cannot confirm the
# process against an empty cgroup.
#
# Type=simple asks systemd for nothing beyond a successful fork, so it is
# immune to the cgroup escape and this unit stops killing a working Shell.
# Readiness stays where it already lives and is already trustworthy: the Shell
# owns the branded boot cover and emits the bounded launcher_interactive_ready
# boot marker, which tools/boot/analyze_boot_markers.py consumes. systemd never
# had a reliable readiness signal for this unit, and the timeout was actively
# destroying the product to compensate.
Type=simple
TimeoutStartSec=90
User=greiakid
Group=greiakid
# Deterministic audio credentials at exec without per-boot account mutation:
# image construction plus the versioned first-boot migration own /etc/group
# truth; this directive resolves the launcher process groups at start.
# Group `tty` is additionally required so the unprivileged X server can open the
# controlling VT with O_RDWR; the stock tty node is write-only for its group.
# Group `netdev` lets the Shell reach iwd on the system bus (iwd's shipped
# policy allows only root and netdev); without it the Shell cannot scan or
# join Wi-Fi (Acer parity audit A1). Keep tty: dropping it breaks Xorg VT1.
SupplementaryGroups=audio tty netdev
PAMName=login
WorkingDirectory=/opt/greia-os
Environment=GREIA_OS_ROOT=/opt/greia-os
Environment=PYTHONPATH=/opt/greia-os/src
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Read-only, root-owned, image-precompiled bytecode (compose_precompile_bytecode;
# greia_platform.bytecode_cache). Activities inherit it only after the
# runtime adapter re-verifies its ownership; a missing prefix is harmless.
Environment=PYTHONPYCACHEPREFIX=/usr/lib/greia/pycache
Environment=HOME=/var/lib/greia-kid
# Present the Shell window through SDL's software framebuffer, not SDL 2.26's
# X11 GL "texture framebuffer". Acer N270/GMA 950 re-sweep at 0f560c2e
# (2026-10-16_ACER_ACTIVITY_SWEEP.md (archived; see git history) R.2): set_mode
# 0.7-1.2 s -> 0.03-0.15 s and ~70 MB less RSS per process because Mesa/libGL
# is never loaded. Activities get the same hint from the Python runtime
# adapter; the launcher does not forward this variable itself.
Environment=SDL_FRAMEBUFFER_ACCELERATION=0
Environment=GREIA_PROFILES_DIR=/var/lib/greia-profiles
Environment=GREIA_ACTIVE_PROFILE_STATUS=/run/greia-os/active-profile.json
Environment=GREIA_ACTIVE_PROFILE_LOCK=/run/greia-update-authority/profile-session.lock
Environment=GREIA_UPDATE_RESTART_FENCE=/run/greia-update-authority/restart-pending.json
Environment=GREIA_MEDIA_ROOT=/media/greia
Environment=GREIA_SYSTEM_SETTINGS_DIR=/var/lib/greia-system-settings
Environment=GREIA_HARDWARE_STATUS=/run/greia-hardware/status.json
# /usr/lib/xorg/Xorg is named directly rather than reached through
# /usr/bin/Xorg, because /usr/bin/Xorg execs /usr/lib/xorg/Xorg.wrap and that
# wrapper is setuid root (mode 4755). Setuid means uid=greiakid with euid=0, and
# xorg-server refuses -logfile outright on a uid/euid mismatch:
#
#   (EE) Fatal server error:
#   (EE) Invalid argument -logfile with elevated privileges
#
# so the server exited immediately and Restart=always turned first boot into a
# splash loop. greia-x-session already documents the intended design: the
# unprivileged X server owns tty1 to activate it. Naming the real binary is what
# makes that true, and it also restores the Xorg log that the refusal prevented.
# This went unnoticed because the live installer's own X is not setuid-wrapped,
# so -logfile worked there for hours; only the installed payload's X refused.
# P4.3 read-only capability delivery: the root generator stages the one-use
# BOOT_HEALTHY token under /run/greia-os/boot-health before this unit
# starts. The launcher (greiakid) reads it read-only at INTERACTIVE_READY
# and never writes it. The leading "-" keeps plain boots (no pending
# transaction, no delivery directory) starting normally: the bind is simply
# skipped instead of failing the unit.
BindReadOnlyPaths=-/run/greia-os/boot-health
# The launcher itself remains unprivileged, but Activity roots can be root-owned
# and sealed read-only. Clean only the curated regenerable host/cache noise in a
# privileged pre-start helper before any Activity registry is constructed.
# The helper is deliberately fail-open so cleanup can never become boot authority.
# Volatile Greia runtime roots are created on every boot by
# /etc/tmpfiles.d/greia-runtime.conf. Do not let an application service chown a
# shared /run path according to whichever service happens to start first.
ExecStartPre=+/usr/local/lib/greia-os/prepare-launcher-vt
# greia-x-session detaches stdin to /dev/null before it spawns anything, so the
# child shell, hardware helpers, Activities and their descendants never inherit
# the controlling VT as stdin. Xorg keeps the VT; only the application tree is
# detached. /run/greia-os is the already greiakid-owned volatile runtime, so the
# X server has a log path it may write; without one Xorg aborts with
# "Cannot open log file /var/log/Xorg.0.log" because /var/log is root-owned.
ExecStart=/usr/bin/xinit /usr/local/lib/greia-os/greia-x-session -- /usr/lib/xorg/Xorg :0 vt1 -logfile /run/greia-os/Xorg.0.log -keeptty -novtswitch -background none -quiet -nolisten tcp -noreset
Restart=always
RestartSec=1
# The X server must own the controlling terminal. TTYPath alone does not make
# the service the controlling process of that TTY; StandardInput=tty-fail does.
# `tty-fail` rather than `tty-force` is deliberate: if something genuinely owns
# tty1 already, fail closed instead of stealing another process's terminal.
# Proved on the reference Acer: without it an unprivileged Xorg cannot activate
# VT1 and fails with "xf86OpenConsole: Switching VT failed", which left the
# branded boot cover repainting forever.
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
# The launcher is a graphical application, so no descendant may read the VT as
# stdin: any such read is SIGTTIN-stopped and freezes the child shell. That
# protection is now provided by greia-x-session detaching stdin, instead of by
# denying the whole service the terminal, which also denied Xorg its VT.
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
# IMPORTANT: this unit currently owns the provisional Xorg display server.
# A desktop-style service sandbox (ProtectSystem/ProtectHome/PrivateTmp and
# restrictive path namespaces) prevents Xorg from opening the VT/DRM/input
# devices and from using its normal runtime/log paths on legacy hardware.
# Activity isolation remains in ActivitySupervisor/Bubblewrap. Re-introduce a
# launcher namespace only after the selected R7 display backend proves the
# exact device/path contract on physical hardware.
LimitCORE=0
TasksMax=128

[Install]
WantedBy=graphical.target
