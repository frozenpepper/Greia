[Unit]
Description=Greia OS one-time initialization
After=local-fs.target
Before=greia-launcher.service greia-parent.service
RequiresMountsFor=/run/greia-persist /var/lib/greia-os /etc/machine-id

[Service]
Type=oneshot
ExecStart=/usr/local/lib/greia-os/first-boot
RemainAfterExit=yes
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
