# L7-PROTOCOLS R0/R1: socket definition for the system-update semantic service.
# Step 8A.6: separate from greia-install-transaction (installer media only);
# this socket serves the installed system.
#
# POSTR1-P3-UPDATE-ACTIVATION: this socket is the normal on-demand product
# contract. The old ConditionPathExists gate on
# /run/greia-os/enable-privileged-transactions (absent on every image) is
# removed: the socket listens from sockets.target on every installed boot.
# Narrow on-demand activation is preserved structurally, not by the gate:
# this unit performs no Exec and no block-device work (it only creates the
# /run/greia-os/system-update.sock listener node); the service starts only
# on the first connection, and the only clients connect post-intro (Parent
# after launcher first-frame readiness). The root service owns staging,
# boot-health confirmation and boot control; greiapanel may only request
# status, candidate verification/staging, reconciliation and the explicit
# profile-picker restart.
[Unit]
Description=Greia OS system-update semantic socket
# Boot-critical-chain ordering (POSTR1-P3-UPDATE-ACTIVATION): deliberately
# no Before=/Requires=/Wants= edge toward greia-first-boot,
# greia-launcher, greia-parent, the intro sweep, the recovery units, or any
# graphical/multi-user target. After=local-fs.target only orders the
# listener node after the filesystem providing /run; nothing on the
# pre-intro path can block on, or be delayed by, this listener. The service
# is never pulled onto the pre-intro critical path: it has no [Install]
# section and is started only by this socket on first connection.
After=local-fs.target

[Socket]
ListenStream=/run/greia-os/system-update.sock
SocketMode=0660
SocketUser=root
SocketGroup=greiapanel
Accept=no
MaxConnections=4
TimeoutSec=5

[Install]
WantedBy=sockets.target
