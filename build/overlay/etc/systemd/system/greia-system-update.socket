# L7-PROTOCOLS R0/R1: socket definition for the system-update semantic service.
# Defined but never enabled: the ConditionPathExists gate below is absent on
# every image, so the socket stays inactive — including during ordinary
# pre-intro boot. No destructive backend is wired at R0/R1.
[Unit]
Description=Greia OS system-update semantic socket
ConditionPathExists=/run/greia-os/enable-privileged-transactions
# Never part of pre-intro boot: no WantedBy/default dependency pulls this in.
After=local-fs.target

[Socket]
ListenStream=/run/greia-os/system-update.sock
SocketMode=0600
SocketUser=root
SocketGroup=root
Accept=no
MaxConnections=4
TimeoutSec=5

[Install]
WantedBy=sockets.target
