# Socket-activated, local A/B system-update worker.
# Only the Greia system-update socket exposes semantic STATUS/VERIFY/STAGE/
# ARM/CONFIRM/RECONCILE and authorized restart operations. It never listens
# on the network, and it resolves inactive-slot identity and update inputs
# in source rather than accepting arbitrary commands or paths.
#
# STAGE runs the same SlotFinalizer and offline apt/dpkg package hooks as the
# physical installer. systemd's former capability whitelist, restricted
# filesystem mount namespace, RestrictSUIDSGID, NoNewPrivileges, task limit
# and syscall restrictions were designed for a small daemon but are not
# compatible with arbitrarily complex Debian maintainer scripts. They caused
# repeated physical installation problems in the matching installer worker.
# The long-lived Parent/browser services remain separately sandboxed. This
# worker is root because it rewrites an inactive full operating-system slot.
[Unit]
Description=Greia OS system-update semantic service
Requires=greia-system-update.socket greia-software-update-recover.service
After=greia-system-update.socket greia-software-update-recover.service
RequiresMountsFor=/run/greia-persist /var/lib/greia-os /boot/grub /etc/greia-os/layout

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/greia-os
Environment=PYTHONPATH=/opt/greia-os/src
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GREIA_UPDATE_STATE_DIR=/var/lib/greia-os
Environment=GREIA_INSTALLED_LAYOUT_RECORD=/etc/greia-os/layout/installed-layout.json
Environment=GREIA_ACTIVE_PROFILE_STATUS=/run/greia-os/active-profile.json
Environment=GREIA_ACTIVE_PROFILE_LOCK=/run/greia-update-authority/profile-session.lock
Environment=GREIA_UPDATE_RESTART_FENCE=/run/greia-update-authority/restart-pending.json
Environment=GREIA_BOOT_JOURNAL_DIR=/run/greia-persist/greia/boot-journal
ExecStart=/usr/bin/python3 -m greia_platform.update_privileged --socket-activated
Restart=no
StandardOutput=journal
StandardError=journal
# No WantedBy: the service starts only on a request through its local socket.
