[Unit]
Description=Apply one authorized Greia software-update job
ConditionPathExists=/etc/greia-os/software-update-bootstrap.json
ConditionPathExists=/var/lib/greia-os/software-updates/pending
Requires=greia-software-update-recover.service
After=greia-software-update-recover.service greia-launcher.service greia-parent.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/greia-os/software-update-bootstrap.py --apply
TimeoutStartSec=300
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt /usr/share/greia /var/lib/greia-os /run/greia-os /run/greia-update-authority
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
LimitCORE=0
TasksMax=16
