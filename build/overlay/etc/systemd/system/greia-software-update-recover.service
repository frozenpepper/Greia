[Unit]
Description=Recover Greia application generation before child services
ConditionPathExists=/etc/greia-os/software-update-bootstrap.json
After=local-fs.target systemd-tmpfiles-setup.service
Before=greia-launcher.service greia-parent.service greia-boot-observer.service greia-boot-health.service greia-boot-health-credential.service greia-system-update.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/greia-os/software-update-bootstrap.py --recover
TimeoutStartSec=120
RemainAfterExit=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt /usr/share/greia /var/lib/greia-os /run/greia-os /run/greia-update-authority
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
LimitCORE=0
TasksMax=8
