# P4.3: root-owned one-use BOOT_HEALTHY capability generator.
# Runs once before the launcher: when a real pending transaction exists
# (first-install or update journal, non-terminal) it generates the
# boot-attempt capability bound to (transaction_id, kernel boot ID,
# trusted launcher path), stores the authoritative
# digest-only record in the root-only /run/greia-boot-health-authority
# directory, and stages only the raw one-use token in the root-owned
# /run/greia-os/boot-health delivery directory the launcher can read but
# never write. Plain boots (no pending journal) exit 0 writing nothing: a
# bounded no-op. Double issuance for one transaction/boot attempt, replays,
# copies and stale boot IDs all fail closed at the root health service,
# which consumes the capability before committing health. The record also
# carries peer_uid as provenance/audit metadata only (not a consume-time
# binding; verify_and_consume never gates on it).
# This unit owns no socket, no journal/GRUB/layout mutation and no generic
# command surface: generation only. The commit owner stays the root
# greia-boot-health service; the launcher-side presentation removal stays
# owned by POSTR1-P4-HEALTH-PROOF.
[Unit]
Description=Greia OS boot-health capability generator
Before=greia-launcher.service
Requires=greia-software-update-recover.service
After=greia-software-update-recover.service
RequiresMountsFor=/run/greia-persist /var/lib/greia-os /boot/grub
# Never part of the pre-intro critical path beyond one bounded journal
# check: plain boots exit immediately, pending boots perform one small
# token generation before the launcher starts. No Requires=/Wants= edge
# toward the launcher here (the launcher pulls this unit via Wants=); this
# unit never delays the first frame by itself.

[Service]
Type=oneshot
User=root
# /run/greia-os is the single launcher runtime root (tmpfiles:
# 0770 greiakid:greiaprofiles). This generator must create the one-use
# delivery directory there while keeping its empty capability set:
# primary group greiakid makes the 0750 directory / 0640 token readable
# by the launcher, and supplementary greiaprofiles grants the parent
# directory write. The 0700 authority record stays root-only.
Group=greiakid
SupplementaryGroups=greiaprofiles
WorkingDirectory=/opt/greia-os
Environment=PYTHONPATH=/opt/greia-os/src
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Greia-owned composition roots (image-owned, never request selectors):
# the update pending journal lives under GREIA_UPDATE_STATE_DIR, the
# first-install pending journal under GREIA_BOOT_JOURNAL_DIR, and the
# bound presenter is the single trusted launcher bootstrap path.
Environment=GREIA_UPDATE_STATE_DIR=/var/lib/greia-os
Environment=GREIA_BOOT_JOURNAL_DIR=/run/greia-persist/greia/boot-journal
Environment=GREIA_BOOT_HEALTH_PEER_PATH=greia_launcher.bootstrap:LauncherBootstrap
ExecStart=/usr/bin/python3 -m greia_platform.boot_health --issue-for-pending
Restart=no
TimeoutStartSec=10
# ReadWritePaths below names /run/greia-boot-health-authority, and systemd
# refuses to start a unit when a ReadWritePaths entry does not exist. The
# generator itself creates that directory (mode 0700) but only after the
# sandbox is applied, so the pre-empted path failed the unit every boot:
#
#   Failed to set up mount namespacing:
#   /run/systemd/unit-root/run/greia-boot-health-authority: No such file or directory
#
# RuntimeDirectory creates it before the sandbox with the same 0700 the code
# wants, and preserves it so the authoritative record survives the oneshot exit.
RuntimeDirectory=greia-boot-health-authority
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
ProtectHome=yes
ProtectSystem=strict
# The generator only reads journals (never writes journal/GRUB/layout
# state): the update/first-install state stays read-only while the two
# /run capability directories stay writable for the record + delivery.
BindReadOnlyPaths=/run/greia-persist /var/lib/greia-os
ReadWritePaths=/run/greia-os /run/greia-boot-health-authority
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
LimitCORE=0
TasksMax=8
