[Unit]
Description=Greia OS parent management service
# P6-PARENT: start behind launcher first-frame readiness. The launcher is
# Type=notify (ready at the real first flip), so this After= edge defers the
# Parent browser/backend until after that readiness without pulling Parent
# into the launcher's own requirements (launcher keeps Wants= only).
After=network.target systemd-tmpfiles-setup.service greia-first-boot.service greia-launcher.service greia-software-update-recover.service
Requires=greia-first-boot.service greia-software-update-recover.service
Wants=network.target

[Service]
Type=simple
User=greiapanel
Group=greiapanel
# iwd's system-bus policy admits only root and group netdev; the Parent
# Wi-Fi controls (list/join) need it (Acer parity audit A1, 2026-10-17).
SupplementaryGroups=netdev
# Parent-created profile directories live under the setgid greiaprofiles tree and
# must be born group-writable (2770). RestrictSUIDSGID remains enabled below,
# so the service cannot repair a missing SGID bit after creation; the explicit
# umask makes the inherited setgid + mkdir permissions satisfy the contract
# without weakening that sandbox.
UMask=0007
WorkingDirectory=/opt/greia-os
Environment=GREIA_OS_ROOT=/opt/greia-os
Environment=PYTHONPATH=/opt/greia-os/src
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Read-only image-precompiled bytecode; see greia-launcher.service.
Environment=PYTHONPYCACHEPREFIX=/usr/lib/greia/pycache
Environment=GREIA_PROFILES_DIR=/var/lib/greia-profiles
Environment=GREIA_ACTIVE_PROFILE_STATUS=/run/greia-os/active-profile.json
Environment=GREIA_ACTIVE_PROFILE_LOCK=/run/greia-update-authority/profile-session.lock
Environment=GREIA_UPDATE_RESTART_FENCE=/run/greia-update-authority/restart-pending.json
Environment=GREIA_SYSTEM_SETTINGS_DIR=/var/lib/greia-system-settings
Environment=GREIA_HARDWARE_STATUS=/run/greia-hardware/status.json
Environment=GREIA_PARENT_ACTIVITY_PACKAGE_ROOT=/var/lib/greia-os/activity-packages
StateDirectory=greia-os
# The state root must remain traversable by greiakid so the launcher can reach
# /var/lib/greia-os/activity-packages/active. Sensitive Parent/update inbox
# state is secured by tighter child-directory/file modes. StateDirectoryMode
# also migrates an existing 0750 state root on upgraded developer machines.
StateDirectoryMode=0755
# The reviewed browser runtime is a committed image payload. Refuse to start the
# management service if the installed bytes differ from the pinned manifest or
# if an unmanifested/demo file appears in the production web root.
ExecStartPre=/usr/bin/python3 -m greia_parent.parent_client_integrity --root /usr/share/greia-parent-app --manifest /opt/greia-os/runtime/parent-app-client.manifest.json --pin /opt/greia-os/runtime/parent-app-client.toml
# production_api serves HTTPS on the LAN :8766 and HTTP only on
# 127.0.0.1:8767 for the built-in Parent panel. OpenSSL creates the
# device-local self-signed certificate in StateDirectory on first start.
# production_api is the explicit installed composition: real fail-closed hardware
# policy over package delivery, update inbox/status, language, system controls and
# bounded AudioService preferences. It remains unprivileged: no processor
# installation, slot-write or reboot API.
ExecStart=/usr/bin/python3 -m greia_parent.production_api --bind 0.0.0.0 --port 8766
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ReadOnlyPaths=/run/greia-hardware
ProtectSystem=strict
ReadWritePaths=/var/lib/greia-os /var/lib/greia-profiles /var/lib/greia-system-settings /run/greia-os
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LimitCORE=0
TasksMax=32

[Install]
WantedBy=multi-user.target
