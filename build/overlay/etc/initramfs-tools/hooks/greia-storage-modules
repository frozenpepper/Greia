#!/bin/sh
set -eu

PREREQ=""
prereqs() {
    echo "$PREREQ"
}
case "${1:-}" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /usr/share/initramfs-tools/hook-functions

# Greia images are assembled away from their eventual hardware. The currently
# supported builders target x86, where SATA/AHCI is part of the broad legacy-PC
# compatibility floor. Probe the TARGET kernel package, however, rather than
# assuming every future architecture exposes these as modules: if a driver is
# built in or genuinely absent on another platform, the hook must not turn that
# future profile into a build failure.
for module in ahci libata sd_mod; do
    if modinfo -k "$version" "$module" >/dev/null 2>&1; then
        manual_add_modules "$module"
    fi
done
