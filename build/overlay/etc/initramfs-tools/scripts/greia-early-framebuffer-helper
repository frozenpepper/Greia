#!/bin/sh
# Shared idempotent Greia early-framebuffer draw attempt.
# Sourced by init-top/local-premount/init-bottom stage scripts. Paints the
# branded white frame on the first stage at which /dev/fb0 exists, then every
# later stage simply reinforces the same static frame. Deliberately nonblocking
# and fail-soft: a missing framebuffer must never delay or break boot.

greia_early_framebuffer_draw() {
    if [ -c /dev/fb0 ]; then
        /usr/lib/greia-boot/greia-fb-splash >/dev/null 2>&1 || true
    fi
}
