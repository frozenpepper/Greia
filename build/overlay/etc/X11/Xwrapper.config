# Greia OS currently starts the provisional Xorg compatibility backend from a
# dedicated systemd appliance session, not from a logind console login. Debian's
# default console-user test therefore rejects the legitimate Greia launcher.
# This does not grant Activities X authority: Xorg is platform-owned and
# Activity isolation remains enforced by the supervisor/runtime boundary.
allowed_users=anybody
needs_root_rights=yes
