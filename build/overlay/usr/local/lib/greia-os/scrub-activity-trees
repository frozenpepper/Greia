#!/bin/sh
# Privileged installed-OS resilience boundary for Activity trees.
#
# systemd runs this helper with the "+" ExecStartPre prefix before dropping to
# greiakid for the launcher. The Python scrub removes only curated regenerable
# host/editor/cache noise. Any helper failure is deliberately fail-open: Activity
# discovery and runtime enrichment isolation remain the authoritative fallback,
# so cleanup itself can never create a launcher restart loop.

set -u

/usr/bin/env \
  PYTHONPATH=/opt/greia-os/src \
  PYTHONNOUSERSITE=1 \
  PYTHONDONTWRITEBYTECODE=1 \
  /usr/bin/python3 -m greia_platform.activity_tree_cleanup
status=$?

if [ "$status" -ne 0 ]; then
  /usr/bin/logger -t greia-activity-tree-cleanup \
    "pre-launch Activity cleanup failed with status $status; continuing launcher startup" \
    2>/dev/null || true
fi

exit 0
