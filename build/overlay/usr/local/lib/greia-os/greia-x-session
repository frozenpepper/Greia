#!/bin/sh
set -eu
export GREIA_OS_ROOT=/opt/greia-os
export GREIA_SYSTEM_SETTINGS_DIR=/var/lib/greia-system-settings
export GREIA_PROFILES_DIR=/var/lib/greia-profiles
export GREIA_ACTIVE_PROFILE_STATUS=/run/greia-os/active-profile.json
export GREIA_HARDWARE_STATUS=/run/greia-hardware/status.json
export PYTHONPATH=/opt/greia-os/src

greia_boot_marker() { printf 'GREIA_BOOT event=%s\n' "$1" >&2; }

greia_boot_marker x_session_enter || true

/usr/bin/python3 -m greia_platform.hardware_session_legacy_x \
  --root "$GREIA_OS_ROOT" \
  --state-dir "$GREIA_SYSTEM_SETTINGS_DIR" \
  --status-path "$GREIA_HARDWARE_STATUS" &
hardware_pid=$!
greia_boot_marker hardware_watcher_spawned || true
cleanup() {
  kill "$hardware_pid" >/dev/null 2>&1 || true
  wait "$hardware_pid" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

set +e
greia_boot_marker child_shell_exec || true
/usr/bin/python3 -m greia_launcher.child_shell
launcher_status=$?
if [ "$launcher_status" -ne 0 ]; then
  echo "Greia profile-aware child shell exited with status $launcher_status; trying trusted presentation fallback" >&2
  /usr/bin/python3 -m greia_launcher.trusted_presentation
  launcher_status=$?
fi
set -e
exit "$launcher_status"
