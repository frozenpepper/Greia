#!/bin/sh
set -eu
export GREIA_OS_ROOT=/opt/greia-os
export GREIA_SYSTEM_SETTINGS_DIR=/var/lib/greia-system-settings
export GREIA_PROFILES_DIR=/var/lib/greia-profiles
export GREIA_ACTIVE_PROFILE_STATUS=/run/greia-os/active-profile.json
export GREIA_HARDWARE_STATUS=/run/greia-hardware/status.json
export PYTHONPATH=/opt/greia-os/src

# Configure pointer acceleration, scaling, tap-to-click, and disable keyboard-freeze on session start
xinput set-prop "SynPS/2 Synaptics TouchPad" "libinput Tapping Enabled" 1 2>/dev/null || true
xinput set-prop "SynPS/2 Synaptics TouchPad" "libinput Accel Speed" 1.0 2>/dev/null || true
xinput set-prop "SynPS/2 Synaptics TouchPad" "Coordinate Transformation Matrix" 2.4 0 0 0 2.4 0 0 0 1 2>/dev/null || true
xinput set-prop "SynPS/2 Synaptics TouchPad" "libinput Disable While Typing Enabled" 0 2>/dev/null || true

/usr/bin/python3 -m greia_platform.hardware_session \
  --root "$GREIA_OS_ROOT" \
  --state-dir "$GREIA_SYSTEM_SETTINGS_DIR" \
  --status-path "$GREIA_HARDWARE_STATUS" &
hardware_pid=$!
cleanup() {
  kill "$hardware_pid" >/dev/null 2>&1 || true
  wait "$hardware_pid" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

# The richer profile-aware child shell replaced the presentation module after
# the reference Acer Xorg path was physically proven.  Keep it as the primary
# product entrypoint, but do not let an exception in that newer composition
# turn a healthy X session into an endless systemd restart loop with only the
# previous boot-status line visible on VT1.  A single fallback to the simpler
# presentation entrypoint preserves a usable child UI while the original child
# shell traceback remains in the journal for diagnosis.
set +e
/usr/bin/python3 -m greia_launcher.child_shell
launcher_status=$?
if [ "$launcher_status" -ne 0 ]; then
  echo "Greia profile-aware child shell exited with status $launcher_status; trying presentation fallback" >&2
  /usr/bin/python3 -m greia_launcher.presentation
  launcher_status=$?
fi
set -e
exit "$launcher_status"
