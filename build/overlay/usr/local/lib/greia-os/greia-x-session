#!/bin/sh
set -eu
export GREIA_OS_ROOT=/opt/greia-os
export GREIA_SYSTEM_SETTINGS_DIR=/var/lib/greia-system-settings
export GREIA_PROFILES_DIR=/var/lib/greia-profiles
export GREIA_ACTIVE_PROFILE_STATUS=/run/greia-os/active-profile.json
export GREIA_HARDWARE_STATUS=/run/greia-hardware/status.json
export PYTHONPATH=/opt/greia-os/src

# Configure pointer acceleration and tap-to-click on session start
xinput set-prop "SynPS/2 Synaptics TouchPad" "libinput Tapping Enabled" 1 2>/dev/null || true
xinput set-prop "SynPS/2 Synaptics TouchPad" "libinput Accel Speed" 0.35 2>/dev/null || true

/usr/bin/python3 -m greia_platform.hardware_session \
  --root "$GREIA_OS_ROOT" \
  --state-dir "$GREIA_SYSTEM_SETTINGS_DIR" \
  --status-path "$GREIA_HARDWARE_STATUS" &
hardware_pid=$!
cleanup() {
  kill "$hardware_pid" >/dev/null 2>&1 || true
  wait "$hardware_pid" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

# Do not exec the launcher here. The shell must remain alive so its EXIT trap
# always reaps the hardware watcher when X or the launcher restarts. The child
# shell composes the authoritative launcher/presentation classes with safe
# profile visual context; it does not duplicate lifecycle or permission policy.
set +e
/usr/bin/python3 -m greia_launcher.child_shell
launcher_status=$?
set -e
exit "$launcher_status"
