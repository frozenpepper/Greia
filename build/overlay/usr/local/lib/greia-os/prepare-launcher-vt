#!/bin/sh
set -eu

greia_boot_marker() { printf 'GREIA_BOOT event=%s\n' "$1" >&2; }

greia_boot_marker launcher_execstartpre_vt_begin || true

# Volatile shared runtime roots are NOT created/chowned by the launcher:
# systemd-tmpfiles owns them every boot so launcher/parent/hardware services
# cannot race ownership. Persistent state (child home, account/group
# membership) is image-static plus the versioned first-boot migration — the
# launcher performs no account mutation on the start path.
# Existence is asserted natively by the unit (AssertPathIsDirectory=...):
# the former shell loop ("Missing Greia runtime root: ...", "[ ! -d ... ]")
# was removed here so PID 1 fails the job closed without a fork.

# Audio state is owned exclusively by the hardware watcher
# (SystemControlService over the shared system-controls store, applied through
# the LegacyX backend). This pre-hook issues no mixer commands, so a launcher
# restart can never clobber stored volume/mute with a hardcoded policy.

# Remove only a proven-stale X lock. Deleting a live server's lock/socket can
# permit a duplicate Xorg instance and destroy the graphical handoff. Malformed
# lock state fails closed behind the branded cover and is handled by service
# retry/recovery rather than guessed away.
x_lock=/tmp/.X0-lock
x_socket=/tmp/.X11-unix/X0
if [ -e "$x_lock" ]; then
  x_pid="$(tr -d '[:space:]' < "$x_lock" 2>/dev/null || true)"
  case "$x_pid" in
    ''|*[!0-9]*)
      echo "Refusing malformed Xorg display lock: $x_lock" >&2
      exit 1
      ;;
  esac
  if kill -0 "$x_pid" 2>/dev/null; then
    echo "Xorg display :0 is already owned by PID $x_pid" >&2
    exit 1
  fi
  rm -f "$x_lock"
  rm -f "$x_socket"
elif [ -e "$x_socket" ]; then
  echo "Refusing orphan Xorg display socket without a lock: $x_socket" >&2
  exit 1
fi
# The Greia early-framebuffer cover and Xorg deliberately use the same virtual
# terminal. Starting X on a different VT would permit Xorg's initial VT
# activation to reveal a clear or black frame before the launcher is ready;
# -novtswitch does not suppress that initial activation. Force VT1 every time
# so service restarts also recover from a parent/recovery VT.
chvt 1 >/dev/null 2>&1 || true

# This is the final pre-X milestone. It intentionally remains 78% on every
# launcher restart: a retry is recovery, not progress. The child shell replaces
# this framebuffer cover only when it has acquired a real graphical surface.
renderer=/usr/lib/greia-boot/greia-fb-splash
if [ -c /dev/fb0 ] && [ -x "$renderer" ]; then
  "$renderer" --progress 78 >/dev/null 2>&1 || true
fi

# The Greia early-framebuffer cover already owns the frame. Xorg's
# `-background none` asks the video driver not to paint a root background so
# the branded frame remains visible until the launcher presents its first real
# frame. Neither request is a mathematical guarantee across drivers:
# frame-by-frame Acer and QEMU recordings remain a mandatory acceptance gate.

greia_boot_marker launcher_execstartpre_vt_end || true
