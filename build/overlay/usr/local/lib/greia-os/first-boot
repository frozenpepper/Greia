#!/bin/sh
set -eu

greia_boot_marker() { printf 'GREIA_BOOT event=%s\n' "$1" >&2; }

greia_boot_marker first_boot_enter || true

marker=/var/lib/greia-os/initialized
# Scoped EXIT trap so the idempotent early exit below still closes the
# boot-marker pair without touching the pinned idempotency line. Removed
# immediately after; the full-run exit marker is emitted explicitly at the end.
trap 'greia_boot_marker first_boot_marker_exit || true' EXIT
# B2 one-time field repair: the launcher no longer mutates account membership
# on the start path, so systems installed before the static audio membership
# need exactly one repair here. Runs even when the initialized marker above
# already exists (existing field machines); gated by its own versioned marker
# so a second run mutates nothing. The marker is written only after the repair
# succeeds; a failed repair exits non-zero before the write and retries via
# the unit's Restart=on-failure. Repairs audio membership only — no
# video/render additions.
audio_groups_marker=/var/lib/greia-os/migrations/b2-audio-groups-v1.done
if [ ! -e "$audio_groups_marker" ]; then
  install -d -m 0755 /var/lib/greia-os/migrations
  if id -nG greiakid 2>/dev/null | tr ' ' '\n' | grep -qx audio; then
    : "greiakid audio membership already present"
  else
    usermod -a -G audio greiakid
  fi
  printf '%s\n' "b2-audio-groups-v1" > "$audio_groups_marker"
fi
[ ! -e "$marker" ] || exit 0
trap - EXIT

boot_progress() {
    value="$1"
    renderer=/usr/lib/greia-boot/greia-fb-splash
    if [ -c /dev/fb0 ] && [ -x "$renderer" ]; then
        "$renderer" --progress "$value" >/dev/null 2>&1 || true
    fi
}

# Userspace is alive and Greia is preparing its persistent state.
boot_progress 55

# Persistent state roots are one-time/install-owned. Volatile /run roots are
# deliberately absent here: systemd-tmpfiles recreates them on every boot from
# /etc/tmpfiles.d/greia-runtime.conf.
# The state-root itself is traversal-only shared infrastructure. Sensitive
# Parent state remains protected by the permissions of its child directories
# and files; 0755 here is required so greiakid can reach the read-only
# parent-installed Activity source without joining the Parent service group.
install -d -m 0755 -o greiapanel -g greiapanel /var/lib/greia-os
install -d -m 0750 -o greiakid -g greiakid /var/lib/greia-kid
install -d -m 2770 -o greiakid -g pipprofiles /var/lib/greia-profiles
install -d -m 2750 -o greiapanel -g pipsettings /var/lib/greia-system-settings
machine_id="$(cat /etc/machine-id 2>/dev/null || true)"
[ -n "$machine_id" ] || systemd-machine-id-setup >/dev/null 2>&1

# A historical developer-builder convenience path wrote known passwords for
# root before later key-only personalization. The 00-greia-security-floor
# already prevents root from authenticating over SSH; first boot also locks the
# root account locally so a raw/interrupted build cannot retain a usable
# bootstrap credential. The managed `greia` account is password-locked at build
# time on base images and set by explicit developer provisioning on dev images.
passwd --lock root >/dev/null 2>&1 || true

# SSH host keys remain absent until an explicitly provisioned developer image or
# a future parent-owned enablement path creates them. Avoid CPU/entropy work in
# the child-visible first-boot critical path.
printf '%s\n' "initialized" > "$marker"
chown greiapanel:greiapanel "$marker"

# Persistent Greia state is now ready. The next visible milestone is owned by
# the launcher VT/X preflight; retries must not fabricate more progress.
boot_progress 65

greia_boot_marker first_boot_marker_exit || true
