#!/bin/sh
set -eu

greia_boot_marker() { printf 'GREIA_BOOT event=%s\n' "$1" >&2; }

greia_boot_marker first_boot_enter || true

marker=/var/lib/greia-os/initialized
# Scoped EXIT trap so the idempotent early exit below still closes the
# boot-marker pair without touching the pinned idempotency line. Removed
# immediately after; the full-run exit marker is emitted explicitly at the end.
trap 'greia_boot_marker first_boot_marker_exit || true' EXIT
# B2 one-time field repair: the launcher no longer mutates account membership
# on the start path, so systems installed before the static audio membership
# need exactly one repair here. Runs even when the initialized marker above
# already exists (existing field machines); gated by its own versioned marker
# so a second run mutates nothing. The marker is written only after the repair
# succeeds; a failed repair exits non-zero before the write and retries via
# the unit's Restart=on-failure. Repairs audio membership only — no
# video/render additions.
audio_groups_marker=/var/lib/greia-os/migrations/b2-audio-groups-v1.done
if [ ! -e "$audio_groups_marker" ]; then
  install -d -m 0755 /var/lib/greia-os/migrations
  if id -nG greiakid 2>/dev/null | tr ' ' '\n' | grep -qx audio; then
    : "greiakid audio membership already present"
  else
    usermod -a -G audio greiakid
  fi
  printf '%s\n' "b2-audio-groups-v1" > "$audio_groups_marker"
fi

# B4 profile ownership migration.
#
# Fresh images are prevented from recreating the historical fault: first-boot
# creates the setgid shared data root before greia-parent starts, and
# ProfileStore creates profile/customization/activity directories as 2770 while
# deliberately leaving storage/progress to the child identity.
#
# Existing PERSIST data still needs one compatibility pass. Do not recursively
# chown the whole child-writable tree on every boot: that makes boot work grow
# with user data and lets a root repair inspect paths supplied by writable
# persistent state. B4 is a new marker because machines may already carry the
# older B3 marker while still containing paths created after that marker.
#
# The compatibility pass has two bounded jobs:
#   1. profile roots (data/<profile>) need shared group-write so the child can
#      create its own storage/progress directories before Parent starts;
#   2. existing storage/progress trees are child-owned and are repaired once.
#
# find(1) does not follow symlinks by default. -xdev prevents an existing child
# tree from crossing into another filesystem, and chown -h changes a symlink
# inode rather than dereferencing it.
profile_data_root=/var/lib/greia-profiles/data
if [ -L "$profile_data_root" ]; then
  echo "Refusing symbolic-link profile data root: $profile_data_root" >&2
  exit 1
fi
if [ -e "$profile_data_root" ] && [ ! -d "$profile_data_root" ]; then
  echo "Refusing non-directory profile data root: $profile_data_root" >&2
  exit 1
fi
# This fixed path is cheap to normalize on every boot and is required before
# Parent starts. Unlike the old recursive sweep, it does not walk user data.
install -d -m 2770 -o greiakid -g pipprofiles "$profile_data_root"

profile_owner_migration=/var/lib/greia-os/migrations/b4-profile-child-roots-v1.done
if [ ! -e "$profile_owner_migration" ]; then
  install -d -m 0755 /var/lib/greia-os/migrations
  if [ -d /var/lib/greia-profiles/data ]; then
    # Existing profile roots are Parent-owned but must remain writable by the
    # shared profile group so greiakid can create storage/progress immediately.
    find /var/lib/greia-profiles/data -mindepth 1 -maxdepth 1 -type d \
      -exec chgrp -- pipprofiles {} + \
      -exec chmod 2770 {} +

    # Only the child-owned roots change owner. Parent-owned customization and
    # activity directories are deliberately outside this migration.
    find /var/lib/greia-profiles/data -mindepth 2 -maxdepth 2 -type d \
      \( -name progress -o -name storage \) \
      -exec sh -c '
        for owned_root do
          find "$owned_root" -xdev -depth -print0 |
            xargs -0 -r chown -h -- greiakid:pipprofiles
          find "$owned_root" -xdev -depth -type d -print0 |
            xargs -0 -r chmod 2770
        done
      ' sh {} +
  fi
  printf '%s\n' "b4-profile-child-roots-v1" > "$profile_owner_migration"
fi

# B5 shared-profile mode migration.
#
# B4 can legitimately have run before a fresh Parent-created profile existed.
# Older images also let the Parent swallow a denied chmod(2770), leaving
# Parent-owned profile/customization/activity directories at umask-derived
# 2750. Current images prevent that at creation time (Parent UMask=0007 +
# ProfileStore fail-closed verification). This bounded compatibility pass
# repairs only the shared Parent-owned directory levels that may already exist.
profile_shared_mode_migration=/var/lib/greia-os/migrations/b5-profile-shared-modes-v1.done
if [ ! -e "$profile_shared_mode_migration" ]; then
  install -d -m 0755 /var/lib/greia-os/migrations
  if [ -d "$profile_data_root" ]; then
    find "$profile_data_root" -mindepth 1 -maxdepth 1 -type d \
      -exec chgrp -- pipprofiles {} + \
      -exec chmod 2770 {} +
    find "$profile_data_root" -mindepth 2 -maxdepth 2 -type d \
      \( -name customization -o -name activities \) \
      -exec chgrp -- pipprofiles {} + \
      -exec chmod 2770 {} +
  fi
  printf '%s\n' "b5-profile-shared-modes-v1" > "$profile_shared_mode_migration"
fi

[ ! -e "$marker" ] || exit 0
trap - EXIT

boot_progress() {
    value="$1"
    renderer=/usr/lib/greia-boot/greia-fb-splash
    if [ -c /dev/fb0 ] && [ -x "$renderer" ]; then
        "$renderer" --progress "$value" >/dev/null 2>&1 || true
    fi
}

# Userspace is alive and Greia is preparing its persistent state.
boot_progress 55

# Persistent state roots are one-time/install-owned. Volatile /run roots are
# deliberately absent here: systemd-tmpfiles recreates them on every boot from
# /etc/tmpfiles.d/greia-runtime.conf.
# The state-root itself is traversal-only shared infrastructure. Sensitive
# Parent state remains protected by the permissions of its child directories
# and files; 0755 here is required so greiakid can reach the read-only
# parent-installed Activity source without joining the Parent service group.
install -d -m 0755 -o greiapanel -g greiapanel /var/lib/greia-os
install -d -m 0750 -o greiakid -g greiakid /var/lib/greia-kid
install -d -m 2770 -o greiakid -g pipprofiles /var/lib/greia-profiles
install -d -m 2750 -o greiapanel -g pipsettings /var/lib/greia-system-settings
# Fresh A/B installation seeds these two fixed settings before target users exist.
for setting in /var/lib/greia-system-settings/language.json /var/lib/greia-system-settings/settings.json; do
    if [ -L "$setting" ]; then
        echo "Refusing symbolic-link initial setting: $setting" >&2
        exit 1
    fi
    if [ -f "$setting" ]; then
        chown greiapanel:pipsettings "$setting"
        chmod 0640 "$setting"
    fi
done
machine_id="$(cat /etc/machine-id 2>/dev/null || true)"
[ -n "$machine_id" ] || systemd-machine-id-setup >/dev/null 2>&1

# A historical developer-builder convenience path wrote known passwords for
# root before later key-only personalization. The 00-greia-security-floor
# already prevents root from authenticating over SSH; first boot also locks the
# root account locally so a raw/interrupted build cannot retain a usable
# bootstrap credential. The managed `greia` account is password-locked at build
# time on base images and set by explicit developer provisioning on dev images.
passwd --lock root >/dev/null 2>&1 || true

# SSH host keys remain absent until an explicitly provisioned developer image or
# a future parent-owned enablement path creates them. Avoid CPU/entropy work in
# the child-visible first-boot critical path.
printf '%s\n' "initialized" > "$marker"
chown greiapanel:greiapanel "$marker"

# Persistent Greia state is now ready. The next visible milestone is owned by
# the launcher VT/X preflight; retries must not fabricate more progress.
boot_progress 65

greia_boot_marker first_boot_marker_exit || true
