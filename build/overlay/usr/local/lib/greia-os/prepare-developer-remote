#!/bin/sh
set -eu

marker=/etc/greia-os/developer-remote
authorized_keys=/var/lib/greia-admin/.ssh/authorized_keys

[ -f "$marker" ] || {
  echo "Greia developer remote marker is absent." >&2
  exit 1
}
# The owner-approved greia/greia development login is the primary path. The
# operator key is an additional automation path and is not required for the
# password login to work.
if [ ! -s "$authorized_keys" ]; then
  echo "Warning: developer operator authorized_keys is empty; password login remains available." >&2
fi

# The launcher needs read/traverse access only to the dedicated developer
# Activity source. Deployment metadata, staging and built-in backups remain
# root-only.
install -d -m 0755 -o root -g root /var/lib/greia-developer
install -d -m 0755 -o root -g root /var/lib/greia-developer/activities
install -d -m 0700 -o root -g root \
  /var/lib/greia-developer/staging \
  /var/lib/greia-developer/backups
install -d -m 0700 -o greiaadmin -g greiaadmin /var/lib/greia-admin/greia-dev-upload

# Developer-only deterministic wired networking. Normal/release Greia does not
# receive this file from the immutable overlay because this helper only runs
# when the explicit developer marker exists.
install -d -m 0755 /etc/systemd/network
cat > /etc/systemd/network/20-greia-developer-ethernet.network <<'NETWORK'
[Match]
Type=ether

[Network]
DHCP=yes
IPv6AcceptRA=yes
MulticastDNS=yes
NETWORK
chmod 0644 /etc/systemd/network/20-greia-developer-ethernet.network

install -d -m 0755 /etc/systemd/resolved.conf.d
cat > /etc/systemd/resolved.conf.d/20-greia-developer.conf <<'RESOLVED'
[Resolve]
MulticastDNS=yes
RESOLVED
chmod 0644 /etc/systemd/resolved.conf.d/20-greia-developer.conf
ln -sfn ../run/systemd/resolve/stub-resolv.conf /etc/resolv.conf

# Reload instead of restart, without blocking: this unit is ordered after
# networkd/resolved, and restarting them synchronously from inside it used to
# take this unit down with them.
networkctl reload 2>/dev/null || systemctl --no-block try-restart systemd-networkd.service
systemctl --no-block try-reload-or-restart systemd-resolved.service || true
systemctl --no-block try-restart avahi-daemon.service 2>/dev/null || true

# SSH host identity belongs to prepare-developer-ssh (one Ed25519 key per
# booted machine); do not generate the full ssh-keygen -A set here.

# Optional legacy operator key for greiaadmin. Absent keys are normal: the
# greia password login (and the image-installed operator key for greia) is the
# supported path.
if [ -d /var/lib/greia-admin/.ssh ]; then
  chown -R greiaadmin:greiaadmin /var/lib/greia-admin/.ssh
  chmod 0700 /var/lib/greia-admin/.ssh
  if [ -f "$authorized_keys" ]; then
    chmod 0600 "$authorized_keys"
  fi
fi

printf '%s\n' ready > /var/lib/greia-developer/remote-ready
chmod 0600 /var/lib/greia-developer/remote-ready
