# Greia OS starts the provisional Xorg compatibility backend from a dedicated
# systemd appliance session (greia-installer.service), not from a logind
# console login. Debian's default console-user test therefore rejects the
# legitimate graphical installer. This does not grant installer payloads or
# Activities X authority: Xorg is platform-owned and payload/Activity isolation
# remains enforced by the installer/supervisor boundary.
allowed_users=anybody
needs_root_rights=yes
