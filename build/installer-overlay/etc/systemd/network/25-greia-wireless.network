# Live-installer Wi-Fi is owned end-to-end by iwd.
#
# This root explicitly enables iwd's built-in network configuration in
# /etc/iwd/main.conf (EnableNetworkConfiguration=true), so iwd owns both
# station/authentication and L3 configuration here. systemd-networkd must not
# claim the wireless link or run a second DHCP client against it.
#
# This intentionally differs from the installed target: the target disables
# iwd network configuration and uses systemd-networkd for DHCP after iwd
# establishes carrier. Keep the two role contracts separate.
[Match]
Name=wl* wlan* wlp* wlx*

[Link]
Unmanaged=yes
