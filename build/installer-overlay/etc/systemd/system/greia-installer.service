# Step 8A.5: unprivileged installer UI.
# The graphical installer runs as the Debian ``nobody`` identity and can
# never open or write raw disks: target selection travels only as an
# identity digest and installation only as nonce+digest over the semantic
# socket ``greia-install-transaction.socket`` to the root
# ``greia-install-transaction.service``, which revalidates every authority
# before any destructive command. The historic unit name is kept (the image
# builder enables ``greia-installer.service``) and aliased to the canonical
# ``greia-installer-ui.service``.
[Unit]
Description=Greia OS graphical installer (unprivileged UI)
Wants=iwd.service systemd-resolved.service systemd-networkd.service avahi-daemon.service
Wants=greia-install-transaction.socket
After=local-fs.target systemd-logind.service iwd.service systemd-resolved.service systemd-networkd.service greia-install-transaction.socket
Conflicts=getty@tty1.service
# Bounded retry budget for Restart=always below: at most 5 starts per 5 min.
# The window must be much longer than one crash cycle (Python import + Xorg
# start takes several seconds on the Acer), otherwise a crash loop never
# reaches the limit and restarts forever. Once exhausted the unit stays failed
# behind the Greia cover painted by ExecStopPost; SSH remains for diagnosis.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=nobody
Group=nogroup
# Xorg needs video/input group access on bare metal; membership is granted
# declaratively here so no image user database change is required. Group `tty`
# is required as well: an unprivileged X server opens the VT with O_RDWR, which
# the stock `crw--w----` tty node denies a write-only group. Proved on the
# reference Acer, where the missing group produced
# "xf86OpenConsole: Cannot open virtual console 1 (Permission denied)".
#
# `netdev` is what lets this unprivileged UI reach the Wi-Fi service. iwd's own
# shipped system-bus policy allows send_destination net.connman.iwd to root and
# to group netdev only, and denies everything else by default. Without this
# group the installer is refused by the bus and reports "no wifi card found"
# even though iwd is running and has already scanned successfully. Reusing the
# group iwd already designates for network clients keeps the grant inside the
# boundary the vendor declares, rather than adding a Greia policy that punches
# a wider hole in the system bus.
#
# `audio` only lets the UI open the ALSA PCM for the one-shot boot chime
# (aplay, greia_platform.boot_chime); it grants no other device or capability.
SupplementaryGroups=video input tty netdev audio
# Service-private runtime root, owned by this unit's unprivileged user, so the
# X server has a log path it may actually write. Without it Xorg aborts with
# "Cannot open log file /var/log/Xorg.0.log" because /var/log is root-owned.
RuntimeDirectory=greia-installer
RuntimeDirectoryMode=0750
WorkingDirectory=/opt/greia-os
Environment=GREIA_OS_ROOT=/opt/greia-os
Environment=GREIA_TARGET_IMAGE_PROFILE=/etc/greia-os/target-image-profile.json
Environment=PYTHONPATH=/opt/greia-os/src
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Read-only bytecode prefix precompiled into the live root at image time
# (compose_precompile_bytecode); avoids a cold compile into the RAM overlay.
Environment=PYTHONPYCACHEPREFIX=/usr/lib/greia/pycache
# Same as greia-launcher.service: keep SDL on the software framebuffer path.
# Otherwise pygame loads Mesa/GL (+~70 MB RSS, 0.7-1.2 s set_mode) inside a
# RAM-only live session (overlay-size=128M). Premortem N2.
Environment=SDL_FRAMEBUFFER_ACCELERATION=0
# prepare-installer-vt creates /run/greia-os and owns VT/X preconditions as
# root; the '+' prefix keeps that privilege after the UI itself dropped to
# the unprivileged identity.
ExecStartPre=+/usr/local/lib/greia-os/prepare-installer-vt
# The client wrapper detaches stdin to /dev/null before exec'ing the graphical
# application, so no installer descendant can ever read the controlling VT and
# be SIGTTIN-stopped. Xorg itself keeps the VT; only the application tree is
# detached. This replaces the old StandardInput=null workaround, which denied
# the X server its VT and made the graphical installer impossible.
ExecStart=/usr/bin/xinit /usr/local/lib/greia-os/greia-installer-client -- :0 vt1 -logfile /run/greia-installer/Xorg.0.log -keeptty -novtswitch -background none -quiet -nolisten tcp -noreset
# Restart=always, not on-failure: the service's main process is xinit, and
# xinit exits 0 whenever its client ends, even when the installer Python died
# with a traceback (exit 1). With on-failure a crash therefore left the text
# console on screen and never restarted (QEMU 2026-10-17: "greia-installer.service:
# Deactivated successfully" right after a traceback). In production the UI never
# exits on purpose: completion calls `systemctl poweroff`, and systemd does not
# restart units during shutdown.
Restart=always
RestartSec=2
# Repaint the Greia cover after every stop so VT1 never shows text between a
# crash and the restart, nor after the retry budget is exhausted.
ExecStopPost=+/usr/local/lib/greia-os/installer-exit-cover
# The X server must own the controlling terminal. TTYPath alone does not make
# the service the controlling process of that TTY; StandardInput=tty-fail does.
# `tty-fail` rather than `tty-force` is deliberate: if something genuinely owns
# tty1 already, fail closed instead of stealing another process's terminal.
# Proved on the reference Acer: this is what lets an unprivileged Xorg take VT1
# instead of failing with "xf86OpenConsole: Switching VT failed".
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
# The installer is a graphical application; its stdin is detached to /dev/null
# by greia-installer-client rather than denied here, so Xorg still inherits the
# controlling TTY that VT1 ownership requires.
StandardOutput=journal
StandardError=journal
PrivateTmp=yes
ProtectHome=read-only
# The unprivileged UI owns no destructive path: payload, support pool and
# target profile verification live in the root transaction service. Xorg
# still needs its normal device/IPC surface, so this stays less confined
# than the transaction service by design.
NoNewPrivileges=yes
LimitCORE=0
TasksMax=128

[Install]
WantedBy=graphical.target
Alias=greia-installer-ui.service
