[Unit]
Description=Greia OS graphical installer
Wants=iwd.service systemd-resolved.service systemd-networkd.service avahi-daemon.service
After=local-fs.target systemd-logind.service iwd.service systemd-resolved.service systemd-networkd.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=30
StartLimitBurst=4

[Service]
Type=simple
User=root
WorkingDirectory=/opt/greia-os
Environment=GREIA_OS_ROOT=/opt/greia-os
Environment=GREIA_HARDWARE_SUPPORT_POOL=/opt/greia-hardware-support
Environment=GREIA_TARGET_IMAGE_PROFILE=/etc/greia-os/target-image-profile.json
Environment=PYTHONPATH=/opt/greia-os/src
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/local/lib/greia-os/prepare-installer-vt
ExecStart=/usr/bin/xinit /usr/bin/python3 -m greia_installer.entrypoint --root /opt/greia-os --payload /run/live/medium/payload/pip-rootfs.squashfs --payload-digest /etc/greia-os/expected-payload.sha256 -- :0 vt1 -keeptty -novtswitch -background none -quiet -nolisten tcp -noreset
Restart=on-failure
RestartSec=2
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
# The installer is a graphical application; it never reads from the terminal.
# Giving it the VT as stdin makes every child a background process group with
# the tty as input, so any child read triggers SIGTTIN and freezes the install.
# stdin must be /dev/null instead.
StandardInput=null
StandardOutput=journal
StandardError=journal
PrivateTmp=yes
ProtectHome=read-only
LimitCORE=0
TasksMax=128

[Install]
WantedBy=graphical.target
