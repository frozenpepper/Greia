# Step 8A.5: root install-transaction service (privileged half of the split).
# Socket-activated by greia-install-transaction.socket, which only the
# unprivileged installer UI can connect to. This service owns every
# destructive installer command, but runs one only while a valid prepared
# transaction executes: PREPARE_PLAN returns nonce + canonical plan +
# digest, and EXECUTE with nonce+digest rematerializes the setup release,
# actual block device, layout adapter, support set and boot backend from
# Greia-owned state below and re-probes safety authority immediately
# before destructive work. Never enabled at boot and never part of
# ordinary pre-intro boot: no WantedBy pulls this in.
[Unit]
Description=Greia OS install-transaction service
Requires=greia-install-transaction.socket
After=greia-install-transaction.socket
# Never part of pre-intro boot and never a generic command runner: this unit
# only serves the bounded PREPARE_PLAN/EXECUTE semantic protocol.

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/greia-os
Environment=PYTHONPATH=/opt/greia-os/src
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Greia-owned install facts. The UI never supplies these: payload and digest
# are the setup release on the installer medium, the target profile is the
# release manifest, and the support pool is the frozen media pool.
#
# A/B release facts arrive as one immutable image-owned file
# (/etc/greia-os/installer-ab.env, generated by build-installer-image.sh
# from the same image profile/release build) loaded through EnvironmentFile
# below and parsed centrally by
# greia_installer.composition.ab_executor_facts_from_environment. The leading
# dash keeps single-root recovery media (which ships no A/B facts) working:
# an A/B profile with missing facts still refuses fail-closed in Python,
# never silently routes to the legacy engine. Individual GREIA_AB_*
# variables remain accepted as explicit test/harness overrides only.
EnvironmentFile=-/etc/greia-os/installer-ab.env
Environment=GREIA_OS_ROOT=/opt/greia-os
Environment=GREIA_INSTALL_PAYLOAD=/run/live/medium/payload/pip-rootfs.squashfs
Environment=GREIA_INSTALL_PAYLOAD_DIGEST=/etc/greia-os/expected-payload.sha256
Environment=GREIA_TARGET_IMAGE_PROFILE=/etc/greia-os/target-image-profile.json
Environment=GREIA_HARDWARE_SUPPORT_POOL=/opt/greia-hardware-support
ExecStart=/usr/bin/python3 -m greia_installer.transaction_service_entrypoint
Restart=no
TimeoutStartSec=5
TimeoutStopSec=5
# Native systemd fd store (LISTEN_FDS + fd 3, see
# greia_installer.transaction_service.main): never StandardInput=socket —
# inetd-style stdin passing leaves LISTEN_FDS unset and the entry exits
# fail-closed. Standard input stays disconnected.
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# Minimum privilege for the real A/B implementation (POSTR1-P2 + POSTR1-P5 D5):
# the unsigned setup-release fresh install mounts/formats the target's slots
# (mount(2), umount(2), BLKRRPART re-read) and probes device identities
# (blkid), which requires CAP_SYS_ADMIN, and installs the verified offline
# hardware-support set via `chroot <slot>` package operations (update /
# install / clean in
# greia_installer.hardware_support_install.TargetHardwareSupportInstaller.install,
# reached through the A/B finalize path via the production argv-array runner
# with shell=False), which requires CAP_SYS_CHROOT: chroot(2) fails with EPERM
# without it. Added only with executable evidence (disposable-loop/tmpfs
# mount/write proof for CAP_SYS_ADMIN; V12F EPERM traceback plus the
# disposable-loop chroot proof for CAP_SYS_CHROOT). Session-04 product-mode
# QEMU then proved apt's normal privilege drop requires CAP_SETUID (seteuid)
# and CAP_SETGID (setegid/setgroups).
#
# CAP_MKNOD is required by the same install leg, from the first real hardware
# install on the reference Acer. After the target is written, the engine runs
# `chroot <target> update-initramfs -u -k all`; mkinitramfs stages a fresh
# /tmp target on the installed system and creates its device nodes with mknod,
# which fails with EPERM without CAP_MKNOD:
#
#   fatal error: create_inode: failed to create character device
#   /tmp/pip-install-target.3vyxk7p2/dev/console. because operation not permitted
#
# That is a capability check, not a filesystem-permission problem: the same
# mknod as an unprivileged user fails identically and succeeds as root. The
# service's capability mask was 0x2400c0 — bits 6, 7, 18 and 21 only.
#
# CAP_CHOWN is the second capability the same unevidenced step turned out to
# need. mkinitramfs's set_attributes calls chown() to restore each staged
# file's original owner and group, and chown(2) to a group the caller does not
# hold requires CAP_CHOWN. The reference Acer install failed on the very next
# attempt with:
#
#   fatal error : set_attributes: failed to change UID and gids on
#   /tmp/pip-install-target.m5dz4tui/etc/gshadow. because operation not permitted
#
# CAP_CHOWN and CAP_MKNOD are both strictly narrower than the CAP_SYS_ADMIN this
# set already carries, so neither grants authority the service did not already
# hold. No other capability is granted.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_SETUID CAP_SETGID CAP_MKNOD CAP_CHOWN
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_SETUID CAP_SETGID CAP_MKNOD CAP_CHOWN
# Exact writable staging/mount paths the implementation needs — nothing
# more. Socket directory (privileged-channel endpoint), PERSIST staging,
# boot-control/grubenv state, first-install journal staging, and the slot
# mount root (BlockSlotFilesystem mounts SYSTEM_A below it). Everything else
# stays read-only under ProtectSystem=strict; /etc/greia-os (release facts,
# payload digest, target profile) is read-only by construction.
ReadWritePaths=/run/greia-os
ReadWritePaths=/run/greia-install/persist
ReadWritePaths=/run/greia-install/boot-control
ReadWritePaths=/run/greia-install/backend-state
ReadWritePaths=/run/greia-install/journal
ReadWritePaths=/run/greia-slots
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
# No network, no shell API: the privileged half speaks only the bounded
# PREPARE_PLAN/EXECUTE protocol over the AF_UNIX socket (kernel peer
# credentials); every block effect is an argument array with shell=False.
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
LimitCORE=0
TasksMax=8
