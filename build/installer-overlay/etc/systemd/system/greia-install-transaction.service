# Privileged one-time OS installer. The UI is unprivileged and can reach
# this service only through the local Greia transaction socket, which checks
# peer credentials and the selected disk before starting installation.
#
# Do not reintroduce systemd sandboxing here: this service builds a complete
# Debian installation, runs apt/dpkg maintainer scripts in the target chroot,
# unpacks device nodes, regenerates initramfs and writes the bootloader. The
# previous CapabilityBoundingSet, NoNewPrivileges, ProtectSystem, PrivateTmp,
# syscall/address-family filters, and task limits caused real Acer failures
# and cannot be justified against an arbitrary package's maintainer scripts.
# These restrictions belong on long-lived network/child-facing services,
# not on the local offline OS installation transaction.
#
# This is *not* a new remote administrative interface. The socket remains
# local-only, owner nobody, mode 0600, and the transaction protocol retains
# its disk confirmation / identity checks.
[Unit]
Description=Greia OS install-transaction service
Requires=greia-install-transaction.socket
After=greia-install-transaction.socket

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/greia-os
Environment=PYTHONPATH=/opt/greia-os/src
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/greia-os/installer-ab.env
Environment=GREIA_OS_ROOT=/opt/greia-os
Environment=GREIA_INSTALL_PAYLOAD=/run/live/medium/payload/pip-rootfs.squashfs
Environment=GREIA_INSTALL_PAYLOAD_DIGEST=/etc/greia-os/expected-payload.sha256
Environment=GREIA_TARGET_IMAGE_PROFILE=/etc/greia-os/target-image-profile.json
Environment=GREIA_HARDWARE_SUPPORT_POOL=/opt/greia-hardware-support
ExecStart=/usr/bin/python3 -m greia_installer.transaction_service_entrypoint
Restart=no
StandardOutput=journal
StandardError=journal
# No WantedBy: socket-activated only, never an unconditional boot service.
