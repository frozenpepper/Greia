#!/bin/sh
# Embed the per-image live-media identifier in the initramfs. Debian live-boot
# compares /conf/uuid.conf with /.disk/live-uuid* on candidate media. This is
# more reliable than trusting the USB device's removable bit, which some real
# flash drives and QEMU device models report incorrectly.
set -eu

PREREQ=""
prereqs() {
  echo "$PREREQ"
}

case "${1:-}" in
  prereqs)
    prereqs
    exit 0
    ;;
esac

source_path=/etc/greia-os/live-media-id
[ -r "$source_path" ] || {
  echo "greia-live-media-id: missing $source_path" >&2
  exit 1
}

case "${DESTDIR:-}" in
  "")
    echo "greia-live-media-id: DESTDIR is not set" >&2
    exit 1
    ;;
esac

install -d -m 0755 "$DESTDIR/conf"
install -m 0644 "$source_path" "$DESTDIR/conf/uuid.conf"
