#!/bin/sh
set -eu

PREREQ=""
prereqs() {
    echo "$PREREQ"
}
case "${1:-}" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /usr/share/initramfs-tools/hook-functions

# Live media is also assembled away from the eventual target hardware. Force
# the generic x86 SATA/AHCI modules whenever the TARGET kernel package exposes
# them, but do not assume every future architecture has the same modular storage
# stack. A built-in or genuinely absent module is not a reason to fail that
# future profile's initramfs build.
for module in ahci libata sd_mod; do
    if modinfo -k "$version" "$module" >/dev/null 2>&1; then
        manual_add_modules "$module"
    fi
done
