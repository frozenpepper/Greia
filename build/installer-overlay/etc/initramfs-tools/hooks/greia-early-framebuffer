#!/bin/sh
set -eu

PREREQ=""
prereqs() {
    echo "$PREREQ"
}
case "${1:-}" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /usr/share/initramfs-tools/hook-functions

# Greia early framebuffer cover: copy the Greia-owned renderer and the
# canonical white boot-logo PPM into the generated initramfs so the first
# initramfs stage that sees /dev/fb0 can paint the branded frame.
#
# The kernel package postinst runs update-initramfs before the builder has
# compiled the renderer, so both files must be copied only when present; the
# later authoritative update-initramfs (after the builder compiles the binary)
# includes them. A missing renderer is therefore fail-soft here, never a reason
# to abort the base package installation.
if [ -f /usr/lib/greia-boot/greia-fb-splash ]; then
    copy_exec /usr/lib/greia-boot/greia-fb-splash /usr/lib/greia-boot/
fi

# The PPM is a regular data file, not an executable; copy it directly.
if [ -f /etc/greia-boot/boot-logo.ppm ]; then
    mkdir -p "$DESTDIR/etc/greia-boot"
    cp /etc/greia-boot/boot-logo.ppm "$DESTDIR/etc/greia-boot/boot-logo.ppm"
    chmod 0644 "$DESTDIR/etc/greia-boot/boot-logo.ppm"
fi

# Ensure early KMS graphics driver is available in initramfs when provided by
# the target kernel so /dev/fb0 is active before root filesystem mount.
# Include the small set of framebuffer drivers that can own the display
# before the root filesystem exists. i915 covers the reference Acer; bochs
# and virtio_gpu cover common QEMU/virtual displays (and keep the release
# boot-cover acceptance bootable in the project's disposable VM); cirrus_qemu
# covers the older QEMU VGA model. Each module is optional and probed.
for module in i915 intel_agp bochs cirrus_qemu virtio_gpu; do
    if modinfo -k "${version:-$(uname -r)}" "$module" >/dev/null 2>&1; then
        manual_add_modules "$module"
    fi
done

