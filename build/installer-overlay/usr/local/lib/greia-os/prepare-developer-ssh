#!/bin/sh
set -eu

# Development-only SSH bootstrap for the live installer. Normal/release media
# keep ssh.service disabled. Developer media use the simple owner recovery
# account provisioned by the installer builder; the user never needs an SSH key.

is_developer=0
if [ -f /etc/greia-os/developer-remote ]; then
    is_developer=1
elif grep -q '^# Development .*SSH policy' /etc/ssh/sshd_config.d/20-greia-parent.conf 2>/dev/null; then
    is_developer=1
fi
[ "$is_developer" -eq 1 ] || exit 0

/usr/bin/id greia >/dev/null 2>&1 || {
    echo "Greia developer SSH account is missing" >&2
    exit 1
}
account_status="$(/usr/bin/passwd -S greia 2>/dev/null || true)"
case "$account_status" in
    "greia P "*) ;;
    *)
        echo "Greia developer SSH account is not password-enabled" >&2
        exit 1
        ;;
esac

cat > /etc/ssh/sshd_config.d/00-greia-security-floor.conf <<'EOF'
# Development Greia SSH security floor.
PasswordAuthentication yes
KbdInteractiveAuthentication no
UsePAM yes
PermitEmptyPasswords no
PermitRootLogin no
AuthenticationMethods password
DenyUsers root
AllowUsers greia
HostKey /etc/ssh/ssh_host_ed25519_key
UseDNS no
EOF
chmod 0644 /etc/ssh/sshd_config.d/00-greia-security-floor.conf

cat > /etc/ssh/sshd_config.d/20-greia-parent.conf <<'EOF'
# Development live-installer SSH policy.
PasswordAuthentication yes
KbdInteractiveAuthentication no
UsePAM yes
PermitEmptyPasswords no
PermitRootLogin no
AuthenticationMethods password
AllowUsers greia
HostKey /etc/ssh/ssh_host_ed25519_key
UseDNS no
X11Forwarding no
AllowTcpForwarding no
PermitTunnel no
EOF
chmod 0644 /etc/ssh/sshd_config.d/20-greia-parent.conf

# The live squashfs may be copied to many USB devices, so it must never expose
# a cloned server identity. Generate one lightweight Ed25519 host key in the
# writable live overlay on first sshd start; reuse it for service restarts.
identity_dir=/var/lib/greia-os
identity_marker="$identity_dir/developer-ssh-host-identity-ready"
install -d -m 0755 "$identity_dir"
if [ ! -f "$identity_marker" ]; then
    rm -f /etc/ssh/ssh_host_rsa_key* \
          /etc/ssh/ssh_host_ecdsa_key* \
          /etc/ssh/ssh_host_ed25519_key*
    /usr/bin/ssh-keygen -q -t ed25519 -N '' -f /etc/ssh/ssh_host_ed25519_key
    chmod 0600 /etc/ssh/ssh_host_ed25519_key
    chmod 0644 /etc/ssh/ssh_host_ed25519_key.pub
    : > "$identity_marker"
    chmod 0644 "$identity_marker"
fi
[ -s /etc/ssh/ssh_host_ed25519_key ] || {
    echo "Greia developer SSH host identity was not created" >&2
    exit 1
}

effective="$(/usr/sbin/sshd -T -C user=greia,host=localhost,addr=127.0.0.1)"
printf '%s\n' "$effective" | grep -qx 'passwordauthentication yes'
printf '%s\n' "$effective" | grep -qx 'kbdinteractiveauthentication no'
printf '%s\n' "$effective" | grep -qx 'permitrootlogin no'
printf '%s\n' "$effective" | grep -qx 'authenticationmethods password'
printf '%s\n' "$effective" | grep -qx 'hostkey /etc/ssh/ssh_host_ed25519_key'
printf '%s\n' "$effective" | grep '^allowusers ' | grep -qw greia
