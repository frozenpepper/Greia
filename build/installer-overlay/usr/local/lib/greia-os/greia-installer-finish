#!/bin/sh
# Root half of the installer completion action (owner decision 2026-10-18).
#
# Activated only by greia-installer-finish.path after the unprivileged
# installer UI has created /run/greia-installer/finish-request in its own
# RuntimeDirectory. This script's entire authority is one machine power-off;
# it takes no arguments and exposes no other operation.
set -eu

# systemd-shutdown inherits PID1's log level and prints live-medium/loop
# teardown warnings over the Greia framebuffer cover at the very end of a
# shutdown (owner report 2026-10-18: text drawn over the splash). Lowering the
# manager log level to emergency only for this final power-off keeps the
# branded cover as the last visible frame. This is runtime-only: boot logging
# and the journal during normal operation are unaffected, and kernel panics
# still print at emergency level.
busctl set-property org.freedesktop.systemd1 /org/freedesktop/systemd1 \
  org.freedesktop.systemd1.Manager LogLevel s emerg >/dev/null 2>&1 || true

exec /usr/bin/systemctl poweroff
