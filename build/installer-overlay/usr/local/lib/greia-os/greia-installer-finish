#!/bin/sh
# Root half of the installer completion action (owner decision 2026-10-18).
#
# Activated only by greia-installer-finish.path after the unprivileged
# installer UI has created /run/greia-installer/finish-request in its own
# RuntimeDirectory. This script's entire authority is one machine power-off;
# it takes no arguments and exposes no other operation.
#
# Presentation: shutdown stays silent. The quiet boot policy also governs
# shutdown, and greia-installer.service's ExecStopPost repaints the Greia
# framebuffer cover when X releases VT1, so the parent sees the Greia artwork
# through power-off instead of systemd status text. Do not raise
# systemd.show_status or the kernel console log level here: doing so prints
# terminal text over the branded cover (owner report 2026-10-18).
set -eu

exec /usr/bin/systemctl poweroff
